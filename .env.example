# =============================================================================
# EduDesk — Ortam Değişkenleri
# =============================================================================
# Bu dosyayı kopyalayıp .env.local olarak kaydedin, gerçek değerleri girin.
# .env.local asla Git'e commit edilmez (.gitignore'da).
# Production değerleri Vercel Dashboard > Settings > Environment Variables'a girin.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard > Settings > API

# Anon (public) key — tarayıcıda güvenli, RLS koruması altında
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Service Role key — SADECE sunucu tarafında kullanılır, client bundle'a ASLA sızmaz
# import 'server-only' ile korunan dosyalarda kullanılır.
# RLS'i bypass eder — asla NEXT_PUBLIC_ prefix'i ile isimlendirilmez.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ─── Güvenlik ────────────────────────────────────────────────────────────────

# JWT imzalama sırrı — min 32 karakter, production'da mutlaka rastgele üret
# Oluşturmak için: openssl rand -hex 32
TOKEN_SECRET=your-minimum-32-character-random-secret-here

# E-posta unsubscribe linki HMAC sırrı — /api/unsubscribe imza doğrulaması için
# Tanımsızsa unsubscribe endpoint'i çalışmaz (UNSUBSCRIBE_SECRET env eksik hatası).
# Oluşturmak için: openssl rand -hex 32
UNSUBSCRIBE_SECRET=your-minimum-32-character-random-secret-here

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# https://console.upstash.com → Database oluştur → REST API bilgilerini al
#
# PRODUCTION'DA ZORUNLU: Redis olmadan /login, /kayit, /onboarding endpoint'leri
# FAIL-CLOSED modunda çalışır (kullanıcıları reddeder).
# Development'ta yoksa in-memory fallback kullanılır.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Hassas endpoint'lerde Redis down olduğunda davranış:
# closed = reddet (güvenli, varsayılan) | open = geçir (availability öncelikli)
RATE_LIMIT_FAIL_MODE=closed

# ─── E-posta (Resend) ────────────────────────────────────────────────────────
# https://resend.com > API Keys > Create API Key
# Alan adını (myedudesk.com.tr) Resend > Domains'e ekleyip DNS'i doğrula
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=EduDesk <noreply@myedudesk.com.tr>
FEEDBACK_TO=info@myedudesk.com.tr
# Production kritik hata bildirimleri alıcısı (boşsa FEEDBACK_TO kullanılır)
ALERT_EMAIL=dev@myedudesk.com.tr

# ─── Uygulama URL ──────────────────────────────────────────────────────────
# E-posta linkleri ve auth redirect'leri için baz URL.
# Tanımsızsa kod 'https://myedudesk.com.tr' varsayar (src/lib/env.ts).
NEXT_PUBLIC_APP_URL=https://myedudesk.com.tr

# ─── Landing Page ────────────────────────────────────────────────────────────
# WhatsApp iletişim numarası (başında + veya boşluk olmadan: 905XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=905000000000

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Tarayıcı push bildirimleri. Üçü de tanımsızsa web push zarifçe devre dışı kalır
# (uygulama çalışır, sadece push gönderilmez — src/infrastructure/push/webpush.ts).
# Anahtar üretmek için: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:info@myedudesk.com.tr
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Background Jobs (Inngest) ───────────────────────────────────────────────
# Development'ta local Inngest dev server'ı kullanmak için:
INNGEST_DEV=1
# Production'da bu satırı kaldırın veya silin.
#
# PRODUCTION'DA ZORUNLU: Inngest Cloud dashboard > Apps > (app) bölümünden alın.
# INNGEST_SIGNING_KEY: webhook imza doğrulaması — bu olmadan /api/inngest imzasız çalışır
#   (proxy.ts'de bu endpoint rate-limit'ten muaf tutulduğu için signing key kritik).
# INNGEST_EVENT_KEY: event gönderimi için.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Loglama ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Development'ta: debug | Production'da: info veya warn

# ─── E2E Testleri (Playwright) — sadece test ortamı ──────────────────────────
# Tanımsızsa fallback değerler kullanılır (localhost + test_*@test.example / Test1234!).
PLAYWRIGHT_BASE_URL=http://localhost:3000
TEST_EMAIL_OGRETMEN=
TEST_PASSWORD_OGRETMEN=
TEST_EMAIL_MUDUR=
TEST_PASSWORD_MUDUR=
TEST_EMAIL_ZUMRE_BASKANI=
TEST_PASSWORD_ZUMRE_BASKANI=
TEST_EMAIL_MUDUR_YARDIMCISI=
TEST_PASSWORD_MUDUR_YARDIMCISI=

# =============================================================================
# DEPLOY ÖNCESI KONTROL LISTESI
# =============================================================================
# Production checklist + yedekleme/KVKK politikası ayrı dosyaya taşındı:
#   → docs/deployment-checklist.md
# Deploy öncesi o listeyi gözden geçirin.
