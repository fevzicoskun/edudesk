# Supabase — Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Supabase Service Role — Dashboard > Settings > API > service_role (secret)
# ZORUNLU: Veli portalı, yoklama yazdırma ve admin işlemleri bu key olmadan çalışmaz.
# DIKKAT: Bu key RLS'i bypass eder. Asla tarayıcıya/client bundle'a gönderme.
#         NEXT_PUBLIC_ prefix'i KESİNLİKLE kullanma.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public token signing secret — min 32 karakter, production'da mutlaka değiştir
# Oluşturmak için: openssl rand -hex 32
TOKEN_SECRET=your-minimum-32-character-random-secret-here

# Gmail SMTP — Geri bildirim maili göndermek için
# Gmail > Hesap Ayarları > Güvenlik > 2 Adımlı Doğrulama açık olmalı
# Sonra: https://myaccount.google.com/apppasswords > "EduDesk" adıyla uygulama şifresi oluştur
SMTP_USER=fevzicoskun91@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Upstash Redis — https://console.upstash.com (opsiyonel; yoksa in-memory fallback)
# Kalıcı rate limiting için gereklidir (cold-start'ta sıfırlanmaz)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
